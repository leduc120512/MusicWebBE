# The Java/Windows side of the project is CRLF in the working tree (see
# .editorconfig); Git stores LF and checks out CRLF.
# Run `git add --renormalize .` once after changing this file.
* text=auto eol=crlf

# Anything Linux executes must stay LF, on every platform:
# a CRLF Dockerfile or shell script breaks inside a container.
Dockerfile      text eol=lf
Dockerfile.*    text eol=lf
.dockerignore   text eol=lf
*.sh            text eol=lf
/mvnw           text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf

# Windows scripts must stay CRLF
*.cmd  text eol=crlf
*.bat  text eol=crlf

# Never touch binaries
*.jar  binary
*.zip  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.mp3  binary
*.mp4  binary
